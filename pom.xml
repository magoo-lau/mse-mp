<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- 独立工程：parent 指向基座 mse-starter-parent（编译/插件/BOM/仓库统一收编，随框架 mvn install），
         仅通过 BOM 消费基座发布件（积木式组装），不属于 ai-mse 聚合模块 -->
    <parent>
        <groupId>com.github.magoo-lau.mse-framework</groupId>
        <artifactId>mse-starter-parent</artifactId>
        <version>1.0.0-SNAPSHOT</version>
        <relativePath/>
    </parent>

    <groupId>com.github.magoo-lau.mse-mp</groupId>
    <artifactId>mse-mp</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>mse-mp</name>
    <description>微信公众号管理平台：账号接入（mp-service）+ 启动器（mp-boot）</description>

    <modules>
        <module>mp-api</module>
        <module>mp-service</module>
        <module>mp-boot</module>
    </modules>

    <properties>
        <!-- mse-ai / mse-open 平台契约（biz↔biz 依赖，基座 BOM 不仲裁，显式版本） -->
        <ai-api.version>main-SNAPSHOT</ai-api.version>
        <open-api.version>main-SNAPSHOT</open-api.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!-- 本工程模块 -->
            <dependency>
                <groupId>com.github.magoo-lau.mse-mp</groupId>
                <artifactId>mp-api</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.github.magoo-lau.mse-mp</groupId>
                <artifactId>mp-service</artifactId>
                <version>${project.version}</version>
            </dependency>
            <!-- mse-ai 平台契约：反向业务模块声明与查询工具（AiBizModuleProvider/AbstractBizQueryTool） -->
            <dependency>
                <groupId>com.github.magoo-lau.mse-modules</groupId>
                <artifactId>ai-api</artifactId>
                <version>${ai-api.version}</version>
            </dependency>
            <!-- mse-open 开放平台契约：开放能力自注册（OpenApiContributor/Descriptor） -->
            <dependency>
                <groupId>com.github.magoo-lau.mse-modules</groupId>
                <artifactId>open-api</artifactId>
                <version>${open-api.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <repositories>
    <repository>
        <id>jitpack</id>
        <url>https://jitpack.io</url>
    </repository>
    </repositories>
</project>
